---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const tagsMap = new Map<string, { rawTag: string; posts: typeof allPosts }>();

  allPosts.forEach((post) => {
    post.data.tags.forEach((tag) => {
      const slug = tag.toLowerCase().replace(/\s+/g, '-');
      if (!tagsMap.has(slug)) {
        tagsMap.set(slug, { rawTag: tag, posts: [] });
      }
      tagsMap.get(slug)!.posts.push(post);
    });
  });

  return Array.from(tagsMap.entries()).map(([slug, data]) => ({
    params: { tag: slug },
    props: {
      rawTag: data.rawTag,
      posts: data.posts.sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
      ),
    },
  }));
}

const { rawTag, posts } = Astro.props;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<BaseLayout
  title={`Field Notes tagged with "${rawTag}" — phd for life`}
  description={`Technical articles and engineering logs tagged under ${rawTag}.`}
  sectionIndex="TAG"
>
  <div class="tag-archive-container">
    <header class="tag-archive-header">
      <div class="header-inner">
        <a href="/blog" class="back-link">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>All field notes</span>
        </a>

        <span class="tag-kicker">TAGGED ARCHIVE</span>
        <h1 class="tag-title">{rawTag}</h1>
        <p class="tag-lead">
          Showing {posts.length} {posts.length === 1 ? 'entry' : 'entries'} indexed under this topic.
        </p>
      </div>
    </header>

    <main class="archive-main">
      <div class="posts-list">
        {
          posts.map((post) => (
            <article class="post-row">
              <div class="row-left">
                <time datetime={post.data.pubDate.toISOString()} class="row-date">
                  {formatDate(post.data.pubDate)}
                </time>
                <div class="tag-cloud row-tags">
                  {post.data.tags.map((t) => (
                    <a
                      href={`/blog/tags/${t.toLowerCase().replace(/\s+/g, '-')}`}
                      class={`tag ${t === rawTag ? 'tag-current' : ''}`}
                    >
                      {t}
                    </a>
                  ))}
                </div>
              </div>

              <div class="row-content">
                <h2 class="row-title">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h2>
                <p class="row-desc">{post.data.description}</p>
                <a href={`/blog/${post.id}`} class="row-link" aria-label={`Read ${post.data.title}`}>
                  <span>Read note</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .tag-archive-container {
    padding-top: clamp(6.5rem, 12vh, 9rem);
    padding-bottom: 8rem;
  }

  .tag-archive-header {
    border-bottom: 1px solid var(--rim);
    padding: 0 var(--ph) clamp(3.5rem, 6vh, 5rem);
    margin-bottom: 3.5rem;
  }

  .header-inner {
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: var(--teal);
    font-family: var(--mono);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 0.8;
  }

  .back-link svg {
    width: 13px;
    height: 13px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2.2;
    transition: transform 0.2s var(--ease);
  }

  .back-link:hover svg {
    transform: translateX(-3px);
  }

  .tag-kicker {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mid);
    font-family: var(--mono);
    display: block;
    margin-bottom: 1rem;
  }

  .tag-title {
    font-family: var(--serif);
    font-size: clamp(2.6rem, 5.5vw, 4.6rem);
    font-weight: 200;
    font-style: italic;
    color: var(--teal);
    line-height: 1.1;
    letter-spacing: -0.035em;
    margin-bottom: 1rem;
  }

  .tag-lead {
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    color: var(--mid);
    line-height: 1.6;
    max-width: 600px;
  }

  .archive-main {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--ph);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--rim);
  }

  .post-row {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 3rem;
    padding: 3rem 0;
    border-bottom: 1px solid var(--rim);
    transition: background 0.2s;
  }

  .post-row:hover {
    background: rgba(255, 255, 255, 0.01);
  }

  .row-left {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .row-date {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    font-family: var(--mono);
  }

  .row-tags {
    margin-top: 0.25rem;
  }

  .tag-current {
    color: var(--teal);
    border-color: var(--teal);
  }

  .row-content {
    display: flex;
    flex-direction: column;
  }

  .row-title {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    font-weight: 200;
    font-style: italic;
    color: var(--prose);
    line-height: 1.3;
    margin-bottom: 0.85rem;
    letter-spacing: -0.02em;
  }

  .row-title a {
    text-decoration: none;
    transition: color 0.2s;
  }

  .row-title a:hover {
    color: var(--teal);
  }

  .row-desc {
    font-size: 0.92rem;
    color: var(--mid);
    line-height: 1.7;
    margin-bottom: 1.5rem;
    max-width: 720px;
  }

  .row-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.76rem;
    color: var(--teal);
    text-decoration: none;
    font-weight: 400;
  }

  .row-link svg {
    width: 12px;
    height: 12px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2.2;
    transition: transform 0.2s var(--ease);
  }

  .row-link:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .post-row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding: 2.25rem 0;
    }
  }
</style>
