---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allTags = Array.from(
  new Set(sortedPosts.flatMap((post) => post.data.tags))
).sort();

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<BaseLayout
  title="Field Notes & Engineering Blog — phd for life"
  description="Technical writing on AI4Science, autonomous agents, synthetic biology tooling, and developer workflows."
  sectionIndex="BLOG"
>
  <div class="blog-archive-container">
    <header class="blog-archive-header">
      <div class="header-inner">
        <span class="blog-kicker">TECHNICAL WRITING &middot; FIELD NOTES</span>
        <h1 class="blog-title">Field Notes &amp; Engineering Logs</h1>
        <p class="blog-lead">
          Reflections on autonomous systems, biological foundation models, physical lab automation,
          and developer tools.
        </p>

        <!-- Interactive Tag Filter Bar -->
        <div class="filter-bar" id="tag-filter-bar">
          <button class="filter-tag active" data-tag="all">All ({sortedPosts.length})</button>
          {
            allTags.map((tag) => (
              <button class="filter-tag" data-tag={tag.toLowerCase().replace(/\s+/g, '-')}>
                {tag}
              </button>
            ))
          }
        </div>
      </div>
    </header>

    <main class="archive-main">
      <div class="posts-list" id="posts-container">
        {
          sortedPosts.map((post) => (
            <article
              class="post-row"
              data-tags={post.data.tags
                .map((t) => t.toLowerCase().replace(/\s+/g, '-'))
                .join(',')}
            >
              <div class="row-left">
                <time datetime={post.data.pubDate.toISOString()} class="row-date">
                  {formatDate(post.data.pubDate)}
                </time>
                <div class="tag-cloud row-tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>

              <div class="row-content">
                <h2 class="row-title">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h2>
                <p class="row-desc">{post.data.description}</p>
                <a href={`/blog/${post.id}`} class="row-link" aria-label={`Read ${post.data.title}`}>
                  <span>Read note</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <div id="no-posts" class="no-posts-msg" style="display: none;">
        No field notes found under this category.
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  function setupTagFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-tag');
    const articles = document.querySelectorAll<HTMLElement>('.post-row');
    const noPosts = document.getElementById('no-posts');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag');

        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        let visibleCount = 0;
        articles.forEach((art) => {
          const tagsAttr = art.getAttribute('data-tags') || '';
          const tagList = tagsAttr.split(',');

          if (tag === 'all' || tagList.includes(tag || '')) {
            art.style.display = 'grid';
            visibleCount++;
          } else {
            art.style.display = 'none';
          }
        });

        if (noPosts) {
          noPosts.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      });
    });
  }

  setupTagFilter();
</script>

<style>
  .blog-archive-container {
    padding-top: clamp(6.5rem, 12vh, 9rem);
    padding-bottom: 8rem;
  }

  .blog-archive-header {
    border-bottom: 1px solid var(--rim);
    padding: 0 var(--ph) clamp(3.5rem, 6vh, 5rem);
    margin-bottom: 3.5rem;
  }

  .header-inner {
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .blog-kicker {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--teal);
    font-family: var(--mono);
    display: block;
    margin-bottom: 1.25rem;
  }

  .blog-title {
    font-family: var(--serif);
    font-size: clamp(2.6rem, 5.5vw, 4.6rem);
    font-weight: 200;
    font-style: italic;
    color: #ffffff;
    line-height: 1.1;
    letter-spacing: -0.035em;
    margin-bottom: 1.25rem;
  }

  .blog-lead {
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    color: var(--mid);
    line-height: 1.6;
    max-width: 680px;
    margin-bottom: 2.5rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1rem;
  }

  .filter-tag {
    font-size: 0.72rem;
    padding: 0.35rem 0.85rem;
    border-radius: 2px;
    border: 1px solid var(--rim);
    color: var(--mid);
    background: transparent;
    font-family: var(--sans);
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s;
  }

  .filter-tag:hover {
    color: var(--prose);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .filter-tag.active {
    color: var(--teal);
    border-color: var(--teal);
    background: rgba(45, 212, 191, 0.08);
  }

  .archive-main {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--ph);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--rim);
  }

  .post-row {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 3rem;
    padding: 3rem 0;
    border-bottom: 1px solid var(--rim);
    transition: background 0.2s;
  }

  .post-row:hover {
    background: rgba(255, 255, 255, 0.01);
  }

  .row-left {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .row-date {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    font-family: var(--mono);
  }

  .row-tags {
    margin-top: 0.25rem;
  }

  .row-content {
    display: flex;
    flex-direction: column;
  }

  .row-title {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    font-weight: 200;
    font-style: italic;
    color: var(--prose);
    line-height: 1.3;
    margin-bottom: 0.85rem;
    letter-spacing: -0.02em;
  }

  .row-title a {
    text-decoration: none;
    transition: color 0.2s;
  }

  .row-title a:hover {
    color: var(--teal);
  }

  .row-desc {
    font-size: 0.92rem;
    color: var(--mid);
    line-height: 1.7;
    margin-bottom: 1.5rem;
    max-width: 720px;
  }

  .row-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.76rem;
    color: var(--teal);
    text-decoration: none;
    font-weight: 400;
  }

  .row-link svg {
    width: 12px;
    height: 12px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2.2;
    transition: transform 0.2s var(--ease);
  }

  .row-link:hover svg {
    transform: translateX(4px);
  }

  .no-posts-msg {
    padding: 4rem 0;
    text-align: center;
    color: var(--mid);
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .post-row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding: 2.25rem 0;
    }
  }
</style>
