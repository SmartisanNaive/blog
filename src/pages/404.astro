---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Not Found | phd for life" description="The requested path could not be resolved." sectionIndex="404">
  <section class="not-found-section">
    <div class="nf-inner">
      <span class="nf-kicker">ERROR 404 &middot; STATE UNRESOLVED</span>
      <h1 class="nf-title">Void in coordinate space.</h1>
      <p class="nf-desc">
        The trajectory you attempted to navigate does not exist in this coordinate frame, or the protocol has been archived.
      </p>

      <a href="/" class="btn-primary">
        <span class="btn-fill"></span>
        <span>Return to origin</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-section {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem var(--ph);
    text-align: center;
  }

  .nf-inner {
    max-width: 600px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .nf-kicker {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--teal);
    font-family: var(--mono);
    margin-bottom: 1.5rem;
  }

  .nf-title {
    font-family: var(--serif);
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    font-weight: 200;
    font-style: italic;
    color: #ffffff;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .nf-desc {
    font-size: 0.95rem;
    color: var(--mid);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }
</style>
