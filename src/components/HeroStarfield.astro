---
---

<section class="hero" data-section="00" aria-label="Hero Section">
  <!-- WebGL Starfield Canvas -->
  <canvas id="webgl" aria-hidden="true"></canvas>

  <!-- Ambient background glow blooms -->
  <div class="hero-bloom" aria-hidden="true"></div>
  <div class="hero-bloom-r" aria-hidden="true"></div>
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="hero-inner">
    <!-- Eyebrow -->
    <div class="hero-eyebrow" id="hero-eye">
      <span class="hero-eyebrow-line" aria-hidden="true"></span>
      <span>AI FOR SCIENCE &middot; AGENTS &amp; AUTOMATION &middot; SYNTHETIC BIOLOGY</span>
    </div>

    <!-- Main Headline with Clip Reveal -->
    <h1 class="hero-h1">
      <span class="clip-wrap">
        <span class="clip-inner">Building autonomous systems</span>
      </span>
      <span class="clip-wrap">
        <span class="clip-inner word-accent">for science and code</span>
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="hero-sub">
      Welcome to <em>phd for life</em> &mdash; Baice&rsquo;s digital garden for AI4Science
      projects, agentic automation workflows, NLP &amp; deep learning experiments, and synthetic biology
      notes.
    </p>

    <!-- 4 Stats Cards -->
    <div class="hero-stats" id="hero-stats" aria-label="Open Source Highlights">
      <div class="stat-cell">
        <span class="stat-val" data-count="19">19</span>
        <span class="stat-lbl">PUBLIC REPOS</span>
      </div>
      <div class="stat-cell">
        <span class="stat-val" data-count="119" data-suffix="+">119+</span>
        <span class="stat-lbl">TOP REPO STARS</span>
      </div>
      <div class="stat-cell">
        <span class="stat-val" data-count="6">6</span>
        <span class="stat-lbl">FEATURED PROJECTS</span>
      </div>
      <div class="stat-cell">
        <span class="stat-val" data-count="4">4</span>
        <span class="stat-lbl">CORE DOMAINS</span>
      </div>
    </div>

    <!-- Call to Actions -->
    <div class="hero-ctas">
      <a href="#projects" class="btn-primary">
        <span class="btn-fill"></span>
        <span>Explore projects</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>

      <a href="/blog" class="btn-ghost">
        <span>Read the blog</span>
      </a>
    </div>
  </div>

  <!-- Scroll Cue -->
  <div class="scroll-cue" id="scroll-cue" aria-hidden="true">
    <div class="scroll-cue-line"></div>
    <span class="scroll-cue-text">SCROLL</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 var(--ph) clamp(4rem, 9vh, 6.5rem);
    overflow: hidden;
  }

  #webgl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image:
      linear-gradient(var(--rim) 1px, transparent 1px),
      linear-gradient(90deg, var(--rim) 1px, transparent 1px);
    background-size: 100px 100px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 60%, black 10%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 60%, black 10%, transparent 100%);
    opacity: 0.25;
  }

  .hero-bloom {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    width: 900px;
    height: 700px;
    left: -15%;
    top: 0;
    background: radial-gradient(ellipse, rgba(45, 212, 191, 0.055) 0%, transparent 60%);
    animation: blob 14s ease-in-out infinite;
  }

  .hero-bloom-r {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    width: 650px;
    height: 550px;
    right: -10%;
    bottom: 10%;
    background: radial-gradient(ellipse, rgba(120, 80, 255, 0.03) 0%, transparent 65%);
    animation: blob 18s ease-in-out infinite reverse;
  }

  @keyframes blob {
    0%, 100% {
      transform: scale(1) translate(0, 0);
    }
    33% {
      transform: scale(1.07) translate(24px, -18px);
    }
    66% {
      transform: scale(0.95) translate(-14px, 12px);
    }
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: var(--max-w);
    width: 100%;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--teal);
    font-weight: 500;
    margin-bottom: 2.2rem;
    opacity: 0; /* GSAP reveals */
  }

  .hero-eyebrow-line {
    width: 24px;
    height: 1px;
    background: var(--teal);
    opacity: 0.7;
    flex-shrink: 0;
  }

  .hero-h1 {
    font-family: var(--serif);
    font-size: clamp(3.2rem, 7.5vw, 6.8rem);
    font-weight: 100;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--prose);
    font-style: italic;
    margin-bottom: 2.5rem;
  }

  .hero-h1 .word-accent {
    font-weight: 200;
    font-style: normal;
    color: var(--mid);
    display: block;
    margin-top: 0.2rem;
  }

  .hero-sub {
    font-size: clamp(0.95rem, 1.8vw, 1.22rem);
    font-weight: 300;
    color: var(--mid);
    letter-spacing: -0.01em;
    max-width: 620px;
    margin-bottom: 3.2rem;
    line-height: 1.6;
  }

  .hero-sub em {
    color: var(--prose);
    font-style: italic;
    font-family: var(--serif);
  }

  .hero-stats {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--rim);
    width: fit-content;
    margin-bottom: 3rem;
    background: rgba(12, 12, 18, 0.4);
    backdrop-filter: blur(8px);
    opacity: 0; /* GSAP reveals */
  }

  .stat-cell {
    padding: 1.2rem 2rem;
    border-right: 1px solid var(--rim);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .stat-cell:last-child {
    border-right: none;
  }

  .stat-val {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    font-weight: 200;
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--prose);
    font-variant-numeric: tabular-nums;
  }

  .stat-lbl {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mid);
    margin-top: 0.4rem;
    font-family: var(--mono);
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    opacity: 0; /* GSAP reveals */
  }

  .scroll-cue {
    position: absolute;
    bottom: 2.5rem;
    right: var(--ph);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0; /* GSAP reveals */
  }

  .scroll-cue-line {
    width: 1px;
    height: 56px;
    background: linear-gradient(180deg, transparent, var(--teal));
    animation: scroll-line 2.2s ease-in-out infinite;
  }

  .scroll-cue-text {
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
    writing-mode: vertical-rl;
    font-family: var(--mono);
  }

  @keyframes scroll-line {
    0%, 100% {
      transform: scaleY(1) translateY(0);
    }
    50% {
      transform: scaleY(0.6) translateY(10px);
    }
  }

  @media (max-width: 768px) {
    .hero-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 100%;
    }
    .stat-cell {
      padding: 1rem 1.25rem;
    }
    .stat-cell:nth-child(2) {
      border-right: none;
    }
    .stat-cell:nth-child(1),
    .stat-cell:nth-child(2) {
      border-bottom: 1px solid var(--rim);
    }
    .scroll-cue {
      display: none;
    }
  }
</style>
