---
import { projects } from '../data/projects';
---

<section class="section" id="projects" data-section="03" aria-label="Open Source Projects">
  <div class="section-inner">
    <div class="sec-kicker">
      <span class="sec-num">03</span>
      <span class="sec-label">PROJECTS</span>
    </div>

    <h2 class="sec-h">
      <span class="clip-wrap">
        <span class="clip-inner">Featured open</span>
      </span>
      <span class="clip-wrap">
        <span class="clip-inner roman">source architectures.</span>
      </span>
    </h2>

    <div class="projects-grid">
      {
        projects.map((proj) => (
          <a
            href={proj.url}
            target="_blank"
            rel="noopener noreferrer"
            class="project-card"
            aria-label={`${proj.name} on GitHub`}
          >
            <div class="card-media">
              <img src={proj.image} alt={proj.name} loading="lazy" />
              <span class="card-num">{proj.num}</span>
              {proj.stars && <span class="card-stars">{proj.stars}</span>}
            </div>

            <div class="card-body">
              <span class="card-kicker">{proj.category}</span>
              <h3 class="card-title">{proj.name}</h3>
              <p class="card-desc">{proj.description}</p>

              <div class="tag-cloud">
                {proj.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>

              <div class="card-link">
                <span>View on GitHub</span>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--rim);
    gap: 0;
    background: var(--bg);
  }

  .project-card {
    position: relative;
    overflow: hidden;
    background: var(--bg2);
    border-right: 1px solid var(--rim);
    border-bottom: 1px solid var(--rim);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: background 0.4s;
  }

  .project-card:nth-child(2n) {
    border-right: none;
  }

  .project-card:nth-last-child(-n + 2) {
    border-bottom: none;
  }

  .project-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      500px circle at var(--mx, 50%) var(--my, 50%),
      rgba(45, 212, 191, 0.065) 0%,
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
    z-index: 2;
  }

  .project-card:hover::before,
  .project-card:focus-visible::before {
    opacity: 1;
  }

  .project-card:focus-visible {
    outline: 1px solid rgba(45, 212, 191, 0.5);
    outline-offset: -1px;
  }

  .card-media {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    background: #09090f;
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.2) saturate(0.9) brightness(0.9);
    transition:
      filter 0.5s,
      transform 0.6s var(--ease);
    display: block;
  }

  .project-card:hover .card-media img,
  .project-card:focus-visible .card-media img {
    filter: grayscale(0) saturate(1) brightness(1);
    transform: scale(1.03);
  }

  .card-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(6, 6, 10, 0) 40%, var(--bg2) 100%);
  }

  .card-num {
    position: absolute;
    bottom: 0.8rem;
    left: 1.25rem;
    z-index: 1;
    font-family: var(--serif);
    font-size: 2.2rem;
    font-weight: 100;
    font-style: italic;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1;
    letter-spacing: -0.05em;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
  }

  .card-stars {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    z-index: 1;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--teal);
    background: rgba(6, 6, 10, 0.75);
    border: 1px solid rgba(45, 212, 191, 0.3);
    padding: 0.2rem 0.6rem;
    border-radius: 2px;
  }

  .card-body {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-kicker {
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
    display: block;
    margin-bottom: 0.85rem;
    font-family: var(--mono);
  }

  .card-title {
    font-family: var(--serif);
    font-size: 1.65rem;
    font-weight: 200;
    font-style: italic;
    color: var(--prose);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    transition: color 0.2s;
  }

  .project-card:hover .card-title {
    color: var(--teal);
  }

  .card-desc {
    font-size: 0.88rem;
    color: var(--mid);
    line-height: 1.7;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.76rem;
    color: var(--teal);
    margin-top: 1.5rem;
    font-weight: 400;
  }

  .card-link svg {
    width: 12px;
    height: 12px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2.2;
    transition: transform 0.2s var(--ease);
  }

  .project-card:hover .card-link svg {
    transform: translate(2px, -2px);
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .project-card {
      border-right: none !important;
    }
    .project-card:last-child {
      border-bottom: none;
    }
    .card-body {
      padding: 1.75rem 1.5rem;
    }
  }
</style>
