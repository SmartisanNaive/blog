---
import { siteConfig } from '../data/site';
---

<section class="section" id="elsewhere" data-section="07" aria-label="Elsewhere & Contact">
  <div class="section-inner">
    <div class="sec-kicker">
      <span class="sec-num">07</span>
      <span class="sec-label">ELSEWHERE</span>
    </div>

    <h2 class="sec-h">
      <span class="clip-wrap">
        <span class="clip-inner">Find me across</span>
      </span>
      <span class="clip-wrap">
        <span class="clip-inner roman">the internet.</span>
      </span>
    </h2>

    <div class="links-list" aria-label="External Directory">
      {
        siteConfig.socials.map((link) => (
          <a
            href={link.url}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="link-row"
          >
            <div class="link-left">
              <span class="link-num">{link.num}</span>
              <span class="link-name">{link.name}</span>
            </div>

            <span class="link-note">{link.note}</span>

            <div class="link-right">
              <span class="link-handle">{link.handle}</span>
              <svg viewBox="0 0 24 24" class="link-arrow" aria-hidden="true">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </div>
          </a>
        ))
      }
    </div>

    <!-- Bottom Collaboration CTA Box -->
    <div class="footer-cta">
      <div class="fcta-inner">
        <span class="fcta-kicker">COLLABORATION &amp; EXCHANGE</span>
        <h3 class="fcta-h">
          <span class="clip-wrap">
            <span class="clip-inner">LET&rsquo;S BUILD TOGETHER</span>
          </span>
        </h3>
        <p class="fcta-sub">
          Always up for chatting about AI4Science, autonomous agents, lab automation, and open-source
          tooling.
        </p>

        <a href={`mailto:${siteConfig.email}`} class="btn-primary fcta-btn">
          <span class="btn-fill"></span>
          <span>Say hello</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .links-list {
    border-top: 1px solid var(--rim);
    margin-bottom: clamp(6rem, 10vh, 8.5rem);
  }

  .link-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.85rem 0;
    border-bottom: 1px solid var(--rim);
    text-decoration: none;
    color: inherit;
    transition:
      background 0.2s,
      padding-left 0.3s var(--ease);
  }

  .link-row:hover {
    padding-left: 1rem;
    background: rgba(255, 255, 255, 0.015);
  }

  .link-left {
    display: flex;
    align-items: baseline;
    gap: 1.75rem;
    min-width: 200px;
  }

  .link-num {
    font-size: 0.65rem;
    color: var(--teal);
    font-family: var(--mono);
    opacity: 0.8;
  }

  .link-name {
    font-family: var(--serif);
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    font-weight: 200;
    font-style: italic;
    color: var(--prose);
    letter-spacing: -0.02em;
    transition: color 0.2s;
  }

  .link-row:hover .link-name {
    color: var(--teal);
  }

  .link-note {
    font-size: 0.82rem;
    color: var(--mid);
    flex: 1;
    padding: 0 2rem;
  }

  .link-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .link-handle {
    font-size: 0.72rem;
    color: var(--dim);
    font-family: var(--mono);
  }

  .link-arrow {
    width: 14px;
    height: 14px;
    stroke: var(--dim);
    fill: none;
    stroke-width: 2.2;
    transition:
      transform 0.25s var(--ease),
      stroke 0.2s;
  }

  .link-row:hover .link-arrow {
    stroke: var(--teal);
    transform: translate(3px, -3px);
  }

  /* Bottom CTA */
  .footer-cta {
    border: 1px solid var(--rim);
    background: radial-gradient(
        ellipse 80% 50% at 50% 0%,
        rgba(45, 212, 191, 0.08) 0%,
        transparent 70%
      ),
      var(--bg2);
    padding: clamp(3.5rem, 8vh, 6rem) clamp(2rem, 5vw, 4.5rem);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .fcta-inner {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .fcta-kicker {
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--teal);
    font-family: var(--mono);
    margin-bottom: 1.5rem;
  }

  .fcta-h {
    font-family: var(--serif);
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    font-weight: 200;
    font-style: italic;
    letter-spacing: -0.04em;
    color: #ffffff;
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  .fcta-sub {
    font-size: 0.95rem;
    color: var(--mid);
    line-height: 1.7;
    margin-bottom: 2.5rem;
    max-width: 500px;
  }

  .fcta-btn {
    padding: 0.95rem 2.5rem;
    font-size: 0.88rem;
  }

  @media (max-width: 768px) {
    .link-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding: 1.5rem 0;
    }
    .link-note {
      padding: 0;
    }
    .link-right {
      width: 100%;
      justify-content: space-between;
      margin-top: 0.25rem;
    }
  }
</style>
